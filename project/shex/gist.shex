          rdf:type [ <Template> ] ?
       )
    } OR @<TaskTemplate>
)

<TemporalRelation>  (
    CLOSED {
       (  $<TemporalRelation_tes> (  &<GistThing_tes> ;
             rdf:type [ <GistThing> ] ? ;
             <name> @linkml:String ? ;
             <description> @linkml:String ?
          ) ;
          rdf:type [ <TemporalRelation> ] ?
       )
    } OR @<Assignment>
)

<Text> CLOSED {
    (  $<Text_tes> (  &<ContentExpression_tes> ;
          rdf:type [ <ContentExpression> ] ?
       ) ;
       rdf:type [ <Text> ] ?
    )
}

<TimeInterval> CLOSED {
    (  $<TimeInterval_tes> (  &<GistThing_tes> ;
          rdf:type [ <GistThing> ] ? ;
          <name> @linkml:String ? ;
          <description> @linkml:String ?
       ) ;
       rdf:type [ <TimeInterval> ] ?
    )
}

<Transaction> CLOSED {
    (  $<Transaction_tes> (  &<Event_tes> ;
          rdf:type [ <Event> ] ?
       ) ;
       rdf:type [ <Transaction> ] ?
    )
}

<UnitGroup> CLOSED {
    (  $<UnitGroup_tes> (  &<Collection_tes> ;
          rdf:type [ <Collection> ] ?
       ) ;
       rdf:type [ <UnitGroup> ] ?
    )
}

<UnitOfMeasure> CLOSED {
    (  $<UnitOfMeasure_tes> (  &<GistThing_tes> ;
          rdf:type [ <GistThing> ] ? ;
          <name> @linkml:String ? ;
