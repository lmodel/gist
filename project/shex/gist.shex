             gist:name @linkml:String ? ;
             gist:description @linkml:String ?
          ) ;
          rdf:type [ gist:Composite ] ?
       )
    } OR @<Collection> OR @<Network> OR @<System>
)

<ContemporaryEvent> CLOSED {
    (  $<ContemporaryEvent_tes> (  &<Event_tes> ;
          rdf:type [ gist:Event ] ?
       ) ;
       rdf:type [ gist:ContemporaryEvent ] ?
    )
}

