# metamodel_version: 1.11.0
# version: 14.1.0
BASE <https://w3id.org/lmodel/gist/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX gist: <https://w3id.org/semanticarts/ns/ontology/gist/>
PREFIX linkml: <https://w3id.org/linkml/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<Account> CLOSED {
    (  $<Account_tes> (  &<Agreement_tes> ;
          rdf:type [ gist:Agreement ] ?
       ) ;
       rdf:type [ gist:Account ] ?
    )
}

<Address>  (
    CLOSED {
       (  $<Address_tes> (  &<Content_tes> ;
             rdf:type [ gist:Content ] ?
          ) ;
          rdf:type [ gist:Address ] ?
       )
    } OR @<ElectronicAddress> OR @<PhysicalAddress>
)

<AddressUsageType> CLOSED {
    (  $<AddressUsageType_tes> (  &<Category_tes> ;
          rdf:type [ gist:Category ] ?
       ) ;
       rdf:type [ gist:AddressUsageType ] ?
    )
}

<Agreement>  (
    CLOSED {
       (  $<Agreement_tes> (  &<Intention_tes> ;
             rdf:type [ gist:Intention ] ?
          ) ;
          rdf:type [ gist:Agreement ] ?
       )
    } OR @<Account> OR @<Contract>
)

<Any> CLOSED {
    (  $<Any_tes> rdf:type . * ;
       rdf:type [ linkml:Any ] ?
    )
}

<Aspect> CLOSED {
    (  $<Aspect_tes> (  &<GistThing_tes> ;
          rdf:type [ <GistThing> ] ? ;
          gist:name @linkml:String ? ;
          gist:description @linkml:String ?
       ) ;
       rdf:type [ gist:Aspect ] ?
    )
}

<Assignment> CLOSED {
    (  $<Assignment_tes> (  &<TemporalRelation_tes> ;
          rdf:type [ gist:TemporalRelation ] ?
       ) ;
       rdf:type [ gist:Assignment ] ?
    )
}

<Behavior> CLOSED {
    (  $<Behavior_tes> (  &<Category_tes> ;
          rdf:type [ gist:Category ] ?
       ) ;
       rdf:type [ gist:Behavior ] ?
    )
}

<Building> CLOSED {
    (  $<Building_tes> (  &<Landmark_tes> ;
          rdf:type [ gist:Landmark ] ?
       ) ;
       rdf:type [ gist:Building ] ?
    )
}

<BundledCatalogItem> CLOSED {
    (  $<BundledCatalogItem_tes> (  &<CatalogItem_tes> ;
          rdf:type [ gist:CatalogItem ] ?
       ) ;
       rdf:type [ gist:BundledCatalogItem ] ?
    )
}

<CatalogItem>  (
    CLOSED {
       (  $<CatalogItem_tes> (  &<Specification_tes> ;
             rdf:type [ gist:Specification ] ?
          ) ;
          rdf:type [ gist:CatalogItem ] ?
       )
    } OR @<BundledCatalogItem> OR @<ProductSpecification> OR @<ServiceSpecification>
)

<Category>  (
    CLOSED {
       (  $<Category_tes> (  &<GistThing_tes> ;
             rdf:type [ <GistThing> ] ? ;
             gist:name @linkml:String ? ;
             gist:description @linkml:String ?
          ) ;
          rdf:type [ gist:Category ] ?
       )
    } OR @<AddressUsageType> OR @<Behavior> OR @<DegreeOfCommitment> OR @<Discipline> OR @<ElectronicAddressType> OR
    @<EquipmentType> OR @<GeneralMediaType> OR @<MediaType> OR @<Medium> OR @<PhysicalActionType> OR @<PhysicalAddressType> OR
    @<ProductCategory> OR @<Tag>
)

<Collection>  (
    CLOSED {
       (  $<Collection_tes> (  &<Composite_tes> ;
             rdf:type [ gist:Composite ] ?
          ) ;
          rdf:type [ gist:Collection ] ?
       )
    } OR @<ControlledVocabulary> OR @<OrderedCollection> OR @<UnitGroup>
)

<Commitment>  (
    CLOSED {
       (  $<Commitment_tes> (  &<Intention_tes> ;
             rdf:type [ gist:Intention ] ?
          ) ;
          rdf:type [ gist:Commitment ] ?
       )
    } OR @<ContingentObligation>
)

<Component>  (
    CLOSED {
       (  $<Component_tes> (  &<GistThing_tes> ;
             rdf:type [ <GistThing> ] ? ;
             gist:name @linkml:String ? ;
             gist:description @linkml:String ?
          ) ;
          rdf:type [ gist:Component ] ?
       )
    } OR @<NetworkLink> OR @<NetworkNode> OR @<OrderedMember>
)

<Composite>  (
    CLOSED {
       (  $<Composite_tes> (  &<GistThing_tes> ;
