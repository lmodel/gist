          ) ;
          rdf:type [ <Agreement> ] ?
       )
    } OR @<Account> OR @<Contract>
)

<Aspect> CLOSED {
    (  $<Aspect_tes> (  &<GistThing_tes> ;
          rdf:type [ <GistThing> ] ? ;
          <name> @linkml:String ? ;
          <description> @linkml:String ?
       ) ;
       rdf:type [ <Aspect> ] ?
    )
}

<Assignment> CLOSED {
