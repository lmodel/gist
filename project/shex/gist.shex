<Tag> CLOSED {
    (  $<Tag_tes> (  &<Category_tes> ;
          rdf:type [ gist:Category ] ?
       ) ;
       rdf:type [ gist:Tag ] ?
    )
}

<Task>  (
    CLOSED {
       (  $<Task_tes> (  &<Event_tes> ;
             rdf:type [ gist:Event ] ?
          ) ;
          rdf:type [ gist:Task ] ?
       )
    } OR @<Project>
)

<TaskTemplate> CLOSED {
    (  $<TaskTemplate_tes> (  &<Template_tes> ;
          rdf:type [ gist:Template ] ?
       ) ;
       rdf:type [ gist:TaskTemplate ] ?
    )
}

<Template>  (
    CLOSED {
       (  $<Template_tes> (  &<GistThing_tes> ;
             rdf:type [ <GistThing> ] ? ;
             gist:name @linkml:String ? ;
             gist:description @linkml:String ?
          ) ;
          rdf:type [ gist:Template ] ?
       )
    } OR @<TaskTemplate>
)

<TemporalRelation>  (
    CLOSED {
       (  $<TemporalRelation_tes> (  &<GistThing_tes> ;
             rdf:type [ <GistThing> ] ? ;
             gist:name @linkml:String ? ;
             gist:description @linkml:String ?
          ) ;
          rdf:type [ gist:TemporalRelation ] ?
       )
    } OR @<Assignment>
)

<Text> CLOSED {
    (  $<Text_tes> (  &<ContentExpression_tes> ;
          rdf:type [ gist:ContentExpression ] ?
       ) ;
       rdf:type [ gist:Text ] ?
    )
}

<TimeInterval> CLOSED {
    (  $<TimeInterval_tes> (  &<GistThing_tes> ;
          rdf:type [ <GistThing> ] ? ;
          gist:name @linkml:String ? ;
          gist:description @linkml:String ?
       ) ;
       rdf:type [ gist:TimeInterval ] ?
    )
}

<Transaction> CLOSED {
    (  $<Transaction_tes> (  &<Event_tes> ;
          rdf:type [ gist:Event ] ?
       ) ;
       rdf:type [ gist:Transaction ] ?
    )
}

<UnitGroup> CLOSED {
    (  $<UnitGroup_tes> (  &<Collection_tes> ;
          rdf:type [ gist:Collection ] ?
       ) ;
       rdf:type [ gist:UnitGroup ] ?
    )
}

<UnitOfMeasure> CLOSED {
    (  $<UnitOfMeasure_tes> (  &<GistThing_tes> ;
          rdf:type [ <GistThing> ] ? ;
          gist:name @linkml:String ? ;
          gist:description @linkml:String ?
       ) ;
       rdf:type [ gist:UnitOfMeasure ] ?
    )
}
