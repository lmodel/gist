<https://w3id.org/lmodel/gist/Assignment> dcterms:title "Assignment" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:ClassDefinition ;
	skos:closeMatch "common_domain_model:NaturalPersonRole"^^xsd:anyURI ;
	skos:editorialNote "OWL equivalentClass: (gist:TemporalRelation & ∃hasGiver.owl:Thing & ∃isAssignmentOf.owl:Thing & ∃isAssignmentTo.owl:Thing)" ;
	skos:exactMatch "gist:Assignment"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:note "Based on the Open World Assumption, the assigner may not be asserted or known." , "For some assignments, such as the assignment of a person to a task, it may seem equally correct in ordinary speech to say it is an assignment of a task to a person. Since gist:isAssignmentTo and gist:isAssignmentOf have no formal domains or ranges, the choice of which predicate to use for which is left as an implementation decision. Consistency is a key consideration." ;
	skos:relatedMatch "common_domain_model:Counterparty"^^xsd:anyURI , "common_domain_model:RelatedParty"^^xsd:anyURI ;
	linkml:class_uri "https://w3id.org/semanticarts/ns/ontology/gist/Assignment"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/Assignment"^^xsd:anyURI ;
	linkml:description "A temporal relationship between an assignee, the thing assigned, and the resource that made the assignment." ;
