<https://w3id.org/lmodel/gist/TemporalRelation> dcterms:title "Temporal Relation" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:ClassDefinition ;
	skos:editorialNote "OWL subClassOf restrictions: =1startDateTime; ≥2hasParticipant" ;
	skos:exactMatch "gist:TemporalRelation"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:note "A temporal relation must have a minimum of two participants. For example, both the employer and the employee are participants in a temporal relation representing a period of employment. Note that 'participant' does not imply agency; a non-sentient being can participate in a temporal relation. For example, both a person and a house could be participants in a hypothetical relation 'lives at.'" ;
	linkml:class_uri "https://w3id.org/semanticarts/ns/ontology/gist/TemporalRelation"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/TemporalRelation"^^xsd:anyURI ;
	linkml:description "A relationship existing for a period of time." ;
	linkml:examples _:c14n200 ;
