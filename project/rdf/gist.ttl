	linkml:range <https://w3id.org/lmodel/gist/datetime> ;
	linkml:slot_uri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndDate"^^xsd:anyURI .
<https://w3id.org/lmodel/gist/actual_end_date_time> dcterms:title "actual end date time" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime"^^xsd:anyURI ;
	skos:note "This is an abstraction over the various precisions of actual end time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes." ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/actual_end_date_time"^^xsd:anyURI ;
	linkml:description "The actual date and time that something ended, with no implied precision." ;
	linkml:domain_of <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:is_a <https://w3id.org/lmodel/gist/end_date_time> ;
	linkml:owner <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:range <https://w3id.org/lmodel/gist/datetime> ;
	linkml:slot_uri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/gist/actual_end_microsecond> dcterms:title "actual end microsecond" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/actualEndMicrosecond"^^xsd:anyURI ;
	skos:note "A system time will be as precise as the system can supply, typically at least milliseconds, sometimes microseconds. The convention for timestamps, such as recording a transaction, is to specify just the end point; the start time is rarely needed." ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/actual_end_microsecond"^^xsd:anyURI ;
	linkml:description "The actual time that something ended, expressed as a system time used for timestamps." ;
	linkml:domain_of <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:examples _:c14n76 ;
	linkml:is_a <https://w3id.org/lmodel/gist/actual_end_date_time> ;
	linkml:owner <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:range <https://w3id.org/lmodel/gist/datetime> ;
	linkml:slot_uri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndMicrosecond"^^xsd:anyURI .
<https://w3id.org/lmodel/gist/actual_end_minute> dcterms:title "actual end minute" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/actualEndMinute"^^xsd:anyURI ;
	skos:note "Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision." ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/actual_end_minute"^^xsd:anyURI ;
	linkml:description "The actual date and time that something ended, with precision of one minute." ;
	linkml:domain_of <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:examples _:c14n325 ;
	linkml:is_a <https://w3id.org/lmodel/gist/actual_end_date_time> ;
