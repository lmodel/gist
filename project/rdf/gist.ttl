<https://w3id.org/lmodel/gist/PhysicalIdentifiableItem> dcterms:title "Physical Identifiable Item" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:ClassDefinition ;
	skos:editorialNote "OWL subClassOf restrictions: ∃isMadeUpOf.gist:PhysicalSubstance; ∃hasMagnitude.∃hasAspect=_Aspect_mass; ∃hasMagnitude.∃hasAspect=_Aspect_volume" ;
	skos:exactMatch "gist:PhysicalIdentifiableItem"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:note "This concept generally corresponds to count nouns in English. By contrast, physical substances, such as an amount of water, flour, or sand, are mass nouns. Physical identifiable items are made up of physical substances; e.g., a cake is made up of butter, flour, and sugar; a statue is made of bronze. If you divide a physical substance such as an amount of water into parts, you have two amounts of water otherwise indistinguishable from one another; if you divide a physical identifiable item such as a computer into parts, each part is different from the whole." ;
	linkml:class_uri "https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/PhysicalIdentifiableItem"^^xsd:anyURI ;
	linkml:description "A discrete physical object which, if subdivided, will result in parts that are distinguishable in nature from the whole and in general also from the other parts." ;
	linkml:disjoint_with <https://w3id.org/lmodel/gist/SchemaMetaData> , <https://w3id.org/lmodel/gist/UnitOfMeasure> ;
	linkml:examples _:c14n83 ;
	linkml:mixins <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:slot_usage _:c14n149 ;
