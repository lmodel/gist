<https://w3id.org/lmodel/gist/Task> dcterms:title "Task" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:ClassDefinition ;
	skos:editorialNote "OWL equivalentClass: (gist:Event & ∃hasGoal.gist:Intention)" ;
	skos:exactMatch "gist:Task"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:note "Something that could potentially be executed, which is merely described but not proposed in any specific way, such as a business process for onboarding a new employee, or the steps in a recipe for making polyethylene from ethylene, is not a task but rather a task template." , "This term is broader than the English word 'task,' which implies assignment, responsibility, or duty. In ordinary English going to a concert has a goal but is (generally) done for pleasure rather than out of obligation, and would not be considered a task, while according to the gist definition it is a task. The expansion of meaning is deliberate, so that anything that has a goal and can be specified by a task template is a task." , "Use the property gist:isBasedOn to link a task back to the task template." ;
	skos:relatedMatch "common_domain_model:Workflow"^^xsd:anyURI , "iso22989:Task"^^xsd:anyURI ;
	linkml:class_uri "https://w3id.org/semanticarts/ns/ontology/gist/Task"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/Task"^^xsd:anyURI ;
	linkml:description "An activity or piece of work that is either proposed, planned, scheduled, underway, or completed." ;
	linkml:is_a <https://w3id.org/lmodel/gist/Event> ;
	linkml:slot_usage _:c14n115 ;
