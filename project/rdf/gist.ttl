_:c14n0 a linkml:Example ;
	skos:example "Transmit electricity, provide ballast, control ambient temperature." .
_:c14n1 a linkml:Example ;
	skos:example "A gym membership is an agreement in which the member commits to paying the gym a certain price and the gym commits to allowing access to their facilities." .
_:c14n10 a linkml:Example ;
	skos:example "In the equation 'profit = revenue - expenses', revenue is an addend and expenses is a subtrahend." .
_:c14n101 a linkml:Example ;
