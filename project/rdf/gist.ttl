	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime"^^xsd:anyURI ;
	skos:note "This is an abstraction over the various precisions of actual start time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes." ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/actual_start_date_time"^^xsd:anyURI ;
	linkml:description "The actual date and time that something started, with no implied precision." ;
	linkml:domain_of <https://w3id.org/lmodel/gist/GistThing> ;
