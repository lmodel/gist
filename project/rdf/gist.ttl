<https://w3id.org/lmodel/gist/conversion_factor> dcterms:title "conversion factor" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "gist:conversionOffset"^^xsd:anyURI ;
	skos:editorialNote "OWL range: (xsd:decimal | xsd:double)" ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/conversionFactor"^^xsd:anyURI ;
	skos:note "To convert a numeric value from one unit of measure to another, multiply by the conversion factor of the first unit and then divide by the conversion factor of the second unit.\n\nFor example, to convert 27 feet to yards:\n\n  the conversion factor of foot is 0.3048\n  the conversion factor of yard is 0.9144\n\n  so\n\n  27 feet = (27 x 0.3048) / 0.9144 = 9 yards" ;
	linkml:any_of _:c14n36 , _:c14n98 ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/conversion_factor"^^xsd:anyURI ;
	linkml:description "A value that relates a unit of measure to units of the International System of Units." ;
	linkml:domain <https://w3id.org/lmodel/gist/UnitOfMeasure> ;
	linkml:domain_of <https://w3id.org/lmodel/gist/UnitOfMeasure> ;
	linkml:examples _:c14n103 ;
	linkml:owner <https://w3id.org/lmodel/gist/UnitOfMeasure> ;
	linkml:range <https://w3id.org/lmodel/gist/string> ;
	linkml:slot_uri "https://w3id.org/semanticarts/ns/ontology/gist/conversionFactor"^^xsd:anyURI .
<https://w3id.org/lmodel/gist/conversion_offset> dcterms:title "conversion offset" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/conversionOffset"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/conversion_offset"^^xsd:anyURI ;
	linkml:description "A value used along with a conversion factor to relate a unit to its corresponding unit in the International System of Units. In the equation below, the conversion offset is 459.669607 and the conversion factor is 5/9.\n\ny degrees Fahrenheit = (y + 459.669607) x 5/9 degrees Kelvin\n\nTo convert from Fahrenheit to Kelvin, first add the offset and then multiply by the conversion factor.\n\nTo convert from Kelvin to Fahrenheit, reverse the steps: first divide by the conversion factor and then subtract the offset." ;
	linkml:domain <https://w3id.org/lmodel/gist/UnitOfMeasure> ;
	linkml:domain_of <https://w3id.org/lmodel/gist/UnitOfMeasure> ;
	linkml:owner <https://w3id.org/lmodel/gist/UnitOfMeasure> ;
	linkml:range <https://w3id.org/lmodel/gist/decimal> ;
	linkml:slot_uri "https://w3id.org/semanticarts/ns/ontology/gist/conversionOffset"^^xsd:anyURI .
