<https://w3id.org/lmodel/gist/Agreement> dcterms:title "Agreement" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:ClassDefinition ;
	skos:closeMatch "common_domain_model:Agreement"^^xsd:anyURI ;
	skos:editorialNote "OWL equivalentClass: (gist:Intention & ∃hasParty.(gist:Organization | gist:Person) & ≥2^isDirectPartOf.gist:Commitment)" ;
	skos:exactMatch "gist:Agreement"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:narrowMatch "common_domain_model:MasterAgreement"^^xsd:anyURI , "dpv:DataProcessingAgreement"^^xsd:anyURI ;
	skos:note "While an agreement has two or more parties, and contains commitments which bind those parties, it will not always be necessary to instantiate each individual commitment." ;
