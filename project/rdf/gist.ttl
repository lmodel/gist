<https://w3id.org/lmodel/gist/Event> dcterms:title "Event" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:ClassDefinition ;
	skos:exactMatch "gist:Event"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:narrowMatch "common_domain_model:BusinessEvent"^^xsd:anyURI , "iso22989:AILifecycleProcess"^^xsd:anyURI , "iso22989:Action"^^xsd:anyURI , "iso22989:DataProcess"^^xsd:anyURI ;
	skos:note "An event does not necessarily have either planned or actual start or end datetimes. For example, a conference can be in the planning phase without any dates selected, but is nevertheless an (unscheduled) event. The subclasses of gist:Event state particular restrictions on planned and actual start and end dates." , "An event occurs during a time interval, which is distinct from the event." ;
	linkml:class_uri "https://w3id.org/semanticarts/ns/ontology/gist/Event"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/Event"^^xsd:anyURI ;
	linkml:description "Something that occurs over a period of time, often characterized as an activity being carried out by some person, organization, or software application or brought about by natural forces." ;
