<https://w3id.org/lmodel/gist/comes_from_agent> dcterms:title "comes from agent" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/comesFromAgent"^^xsd:anyURI ;
	skos:note "This is not the inverse of gist:goesToAgent, as both properties have the message or shipment as the subject." , "This property is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another, whereas gist:hasGiver is typically used in more abstract contexts such as agreements, obligations, contracts, etc. However, there are contexts in which either may be appropriate, such as the giving of a gift." ;
	linkml:any_of _:c14n108 , _:c14n182 ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/comes_from_agent"^^xsd:anyURI ;
	linkml:description "Relates something to the originating agent." ;
	linkml:domain_of <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:examples _:c14n51 ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/gist/has_participant> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:range <https://w3id.org/lmodel/gist/Any> ;
	linkml:slot_uri "https://w3id.org/semanticarts/ns/ontology/gist/comesFromAgent"^^xsd:anyURI .
