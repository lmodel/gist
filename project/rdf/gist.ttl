<https://w3id.org/lmodel/gist/Content> dcterms:title "Content" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:ClassDefinition ;
	skos:exactMatch "gist:Content"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:note "Categories are not content until they are written down." , "This class includes both abstract content and its expression, but it must have at least one expression in order to be content. For example, the idea a writer has for a book is not content until it is expressed in some form, but a single content object may have multiple expressions - e.g., the particular print and audio editions." ;
	linkml:class_uri "https://w3id.org/semanticarts/ns/ontology/gist/Content"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/Content"^^xsd:anyURI ;
	linkml:description "Information available in some medium." ;
	linkml:disjoint_with <https://w3id.org/lmodel/gist/GeoPoint> , <https://w3id.org/lmodel/gist/GeoRegion> , <https://w3id.org/lmodel/gist/Organization> , <https://w3id.org/lmodel/gist/PhysicalIdentifiableItem> , <https://w3id.org/lmodel/gist/PhysicalSubstance> , <https://w3id.org/lmodel/gist/UnitOfMeasure> ;
