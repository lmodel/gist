<https://w3id.org/lmodel/gist/actual_start_microsecond> dcterms:title "actual start microsecond" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/actualStartMicrosecond"^^xsd:anyURI ;
	skos:note "A system time will be as precise as the system can supply, typically at least milliseconds, sometimes microseconds. The convention for timestamps, such as recording a transaction, is to specify just the end point; the start time is rarely needed. This property is defined for the cases when you do need to capture the runtime of a system process, and is then used in conjunction with gist:actualEndMicrosecond." ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/actual_start_microsecond"^^xsd:anyURI ;
	linkml:description "The actual time that something started, expressed as a system time used for timestamps." ;
	linkml:domain_of <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:examples _:c14n328 ;
