<https://w3id.org/lmodel/gist/has_direct_broader> dcterms:title "has direct broader" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/hasDirectBroader"^^xsd:anyURI ;
	skos:note "Unlike gist:hasBroader, this property is not transitive. It is safest to use this property when semantic directness is inherent in the relationship. Otherwise, there is a risk of making a hasDirectBroader assertion and then later inserting an intermediate part; this will result in making an asserted triple false even though there was no change in the world. When in doubt, use the transitive version gist:hasBroader." ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/has_direct_broader"^^xsd:anyURI ;
	linkml:description "Relates a thing to another thing with a broader meaning, when there is no intermediate between them." ;
	linkml:domain_of <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/gist/has_broader> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:range <https://w3id.org/lmodel/gist/Any> ;
	linkml:slot_uri "https://w3id.org/semanticarts/ns/ontology/gist/hasDirectBroader"^^xsd:anyURI .
<https://w3id.org/lmodel/gist/has_divisor> dcterms:title "has divisor" ;
