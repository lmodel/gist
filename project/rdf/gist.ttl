<https://w3id.org/lmodel/gist/is_direct_part_of> dcterms:title "is direct part of" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf"^^xsd:anyURI ;
	skos:note "Because the part has independent existence, there is no cascading delete." , "It is safest to use this property when semantic directness is inherent in the relationship, rather than simply expressing a chosen granularity. For example, a spark plug is a direct part of an engine block; there cannot be any intermediate parts. Otherwise, there is a risk of making an isDirectPartOf assertion and then later inserting an intermediate part; this will result in making an asserted triple false even though there was no change in the world. When in doubt, use the transitive version gist:isPartOf." ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/is_direct_part_of"^^xsd:anyURI ;
	linkml:description "The relationship between a part and a whole where the part has independent existence and there are no other parts in between." ;
	linkml:domain_of <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/gist/is_part_of> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:range <https://w3id.org/lmodel/gist/Any> ;
	linkml:slot_uri "https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf"^^xsd:anyURI .
