<https://w3id.org/lmodel/gist/actual_end_date> dcterms:title "actual end date" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/actualEndDate"^^xsd:anyURI ;
	skos:note "Used for things where the precision of a date is sufficient, such as most projects, tasks, and the like. Recommended usage is to zero out the hours through microseconds to avoid spurious precision." ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/actual_end_date"^^xsd:anyURI ;
	linkml:description "The actual date that something ended, with precision of one day." ;
	linkml:domain_of <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:examples _:c14n206 ;
	linkml:is_a <https://w3id.org/lmodel/gist/actual_end_date_time> ;
