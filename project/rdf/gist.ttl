	linkml:slot_uri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndMinute"^^xsd:anyURI .
<https://w3id.org/lmodel/gist/actual_end_year> dcterms:title "actual end year" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/actualEndYear"^^xsd:anyURI ;
	skos:note "Used for things where the precision of a year is sufficient. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included." ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/actual_end_year"^^xsd:anyURI ;
	linkml:description "The actual date that something ended, with precision of one year." ;
	linkml:domain_of <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:examples _:c14n208 , _:c14n31 ;
	linkml:is_a <https://w3id.org/lmodel/gist/actual_end_date_time> ;
	linkml:owner <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:range <https://w3id.org/lmodel/gist/datetime> ;
	linkml:slot_uri "https://w3id.org/semanticarts/ns/ontology/gist/actualEndYear"^^xsd:anyURI .
