<https://w3id.org/lmodel/gist/TaskTemplate> dcterms:title "Task Template" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:ClassDefinition ;
	skos:editorialNote "OWL equivalentClass: (gist:Template & ∃hasGoal.gist:Intention)" ;
	skos:exactMatch "gist:TaskTemplate"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:note "A task template may define a single activity or a series of activities; the level of granularity can be varied according to use case. For example, in a new employee onboarding process, signing up for benefits might be one activity, or it might be broken down into signing up for health insurance, signing up for dental insurance, etc." , "Use the property isBasedOn to link the Task back to the TaskTemplate." ;
	linkml:class_uri "https://w3id.org/semanticarts/ns/ontology/gist/TaskTemplate"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/TaskTemplate"^^xsd:anyURI ;
	linkml:description "An outline of a task of a particular type, which is the basis for executing such tasks." ;
	linkml:examples _:c14n288 ;
	linkml:is_a <https://w3id.org/lmodel/gist/Template> ;
	linkml:slot_usage _:c14n134 ;
