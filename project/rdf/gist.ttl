<https://w3id.org/lmodel/gist/has_accuracy> dcterms:title "has accuracy" ;
	OIO:inSubset <https://w3id.org/lmodel/gist/gist_core> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/gist/core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/semanticarts/ns/ontology/gist/hasAccuracy"^^xsd:anyURI ;
	skos:note "gist uses the ISO-5725 definition of accuracy, which is a combination of trueness (a measure of systemic error) and precision (a measure of random error). The accuracy of a measurement method describes how close its measurements are to actual values. Similarly, the accuracy of an individual measurement is its likely closeness to the actual value. When we say a temperature measurement is accurate to within a tenth of a degree, it means with a certain probability such as 95%.\n\nNote that the unit of measure of the accuracy has to be compatible with the unit of measure of the original magnitude (e.g. something measured in meters could have an accuracy in terms of millimeters or any other unit that measures distance)." ;
	linkml:annotations _:c14n194 ;
	linkml:definition_uri "https://w3id.org/lmodel/gist/has_accuracy"^^xsd:anyURI ;
	linkml:description "Relates a magnitude to another magnitude that describes its accuracy." ;
	linkml:domain_of <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:examples _:c14n104 ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/gist/GistThing> ;
	linkml:range <https://w3id.org/lmodel/gist/Magnitude> ;
	linkml:slot_uri "https://w3id.org/semanticarts/ns/ontology/gist/hasAccuracy"^^xsd:anyURI .
