      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfKilogram",
      "range": "decimal",
      "@type": "SlotDefinition"
    },
    {
      "name": "exponent_of_meter",
      "definition_uri": "https://w3id.org/lmodel/gist/exponent_of_meter",
      "description": "The exponent of meter in a product of powers of base units.",
      "notes": [
        "OWL domain: (gist:UnitGroup | gist:UnitOfMeasure)"
      ],
      "examples": [
        {
          "value": "In the equation '1 microgram per milliliter = 0.001 x kilogram per meterCubed'\r\n\r\n\t\tthe conversion factor for microgram per milliliter is 0.001\r\n\t\tthe exponent of kilogram is 1\r\n\t\tthe exponent of meter is -3\r\n\t\tall other exponents are zero\r\n\r\n\t\tEvery member of a unit group containing microgram per milliliter must be a multiple of kilogram per meterCubed.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
