    {
      "name": "has_unit_group",
      "definition_uri": "https://w3id.org/lmodel/gist/has_unit_group",
      "description": "Relates an aspect to a unit group. The aspect can be measured using any of the members of the unit group.",
      "examples": [
        {
          "value": "The aspect distance can have a unit group that includes the units meter, inch, foot, etc.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
