    {
      "name": "GeoLocation",
      "definition_uri": "https://w3id.org/lmodel/gist/GeoLocation",
      "description": "A physical location, with the earth as a frame of reference.",
      "comments": [
        "A geographic location may be a point, region, or volume."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
