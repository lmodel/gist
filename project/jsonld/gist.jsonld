    },
    {
      "name": "Equipment",
      "definition_uri": "https://w3id.org/lmodel/gist/Equipment",
      "description": "Human-made, tangible property other than land or buildings used to perform a task or activity.",
      "notes": [
        "OWL equivalentClass: (gist:PhysicalIdentifiableItem & \u2203isCategorizedBy.gist:EquipmentType)"
      ],
      "examples": [
        {
          "value": "A machine, a router, a car, a baseball bat.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "Equipment"
      ],
      "mappings": [
        "gist:Equipment"
