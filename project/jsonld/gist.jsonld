      "range": "decimal",
      "@type": "SlotDefinition"
    },
    {
      "name": "exponent_of_number",
      "definition_uri": "https://w3id.org/lmodel/gist/exponent_of_number",
      "description": "The exponent of number in a product of powers of base units.",
      "notes": [
        "OWL domain: (gist:UnitGroup | gist:UnitOfMeasure)"
      ],
      "comments": [
        "Use when the unit of measure involves a count or other number."
      ],
      "examples": [
        {
          "value": "In the equation '1 beat per minute = 0.016667 x number per second'\r\n\r\n\t\tthe conversion factor for beat per minute is 0.016667\r\n\t\tthe exponent of number is 1\r\n\t\tthe exponent of second is -1\r\n\t\tall other exponents are zero\r\n\r\n\t\tEvery member of a unit group containing beat per minute must be a multiple of number per second.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "exponent of number"
      ],
      "mappings": [
