      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/semanticarts/ns/ontology/gist/GovernedGeoRegion",
      "@type": "ClassDefinition"
    },
    {
      "name": "GovernmentOrganization",
      "definition_uri": "https://w3id.org/lmodel/gist/GovernmentOrganization",
      "description": "An independent organization exercising political and/or regulatory authority over a political unit, people, geographical region, etc., as well as performing certain functions for this unit or body.",
      "comments": [
        "Includes administrative, regulatory, and enforcement organizations created or sanctioned by country or sub-country governments."
      ],
      "examples": [
        {
          "value": "Negative example: A corporation, which is owned and therefore not independent.",
          "@type": "Example"
        },
        {
          "value": "The State of Washington Office of Financial Management; the Food and Drug Administration; the Scottish Parliament.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "Government Organization"
      ],
      "mappings": [
        "gist:GovernmentOrganization"
      ],
      "broad_mappings": [
        "common_domain_model:LegalEntity"
      ],
      "is_a": "Organization",
      "slots": [
        "name",
