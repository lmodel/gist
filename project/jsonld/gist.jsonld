      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/isGovernedBy",
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "is_identified_by",
      "definition_uri": "https://w3id.org/lmodel/gist/is_identified_by",
      "annotations": [
        {
          "tag": "owl_inverse_functional",
          "value": true,
          "@type": "Annotation"
        }
      ],
      "description": "Relates something to a content object that uniquely identifies it.",
      "comments": [
        "This is like a URI: a thing can have more than one ID, but each ID can refer to only one thing. Note that it is possible to have two IDs with the same text that refer to different things."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "is identified by"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/isIdentifiedBy"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/isIdentifiedBy",
      "range": "ID",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "is_made_up_of",
      "definition_uri": "https://w3id.org/lmodel/gist/is_made_up_of",
      "description": "Relates something to a substance that it is made up of.",
      "examples": [
        {
          "value": "A vase is made of clay; water is made up of hydrogen and oxygen.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
