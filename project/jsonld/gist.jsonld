    {
      "name": "goes_to_agent",
      "definition_uri": "https://w3id.org/lmodel/gist/goes_to_agent",
      "description": "Relates something to the agent that receives it.",
      "title": "goes to agent",
      "comments": [
        "This is not the inverse of gist:comesFromAgent, as both properties have the message or shipment as the subject.",
        "This property is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another, whereas gist:hasRecipient is typically used in more abstract contexts such as agreements, obligations, contracts, etc. However, there are contexts in which either may be appropriate, such as the receiving of a gift."
      ],
      "examples": [
        {
          "value": "A package is sent to a person; a purchase order email is received by a vendor.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/goesToAgent"
      ],
      "is_a": "has_participant",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/goesToAgent",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "any_of": [
        {
          "range": "Organization",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "Person",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "goes_to_place",
      "definition_uri": "https://w3id.org/lmodel/gist/goes_to_place",
      "description": "Relates something to its destination place.",
      "title": "goes to place",
      "examples": [
        {
          "value": "A letter has an address indicating its destination; a segment of a delivery route terminates at a delivery location; a trail terminates at an intersection with another trail.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/goesToPlace"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/goesToPlace",
      "owner": "GistThing",
