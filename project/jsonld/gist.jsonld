    {
      "name": "is_governed_by",
      "definition_uri": "https://w3id.org/lmodel/gist/is_governed_by",
      "description": "Relates an entity to another entity that controls, directs, determines or has a guiding influence or authority over it.",
      "examples": [
        {
          "value": "A country geographic region is governed by a country government; the installation and use of software is governed by a license.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
