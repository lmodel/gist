    {
      "name": "numeric_value",
      "definition_uri": "https://w3id.org/lmodel/gist/numeric_value",
      "description": "The actual value of a magnitude.",
      "notes": [
        "OWL range: (xsd:byte | xsd:decimal | xsd:double | xsd:float | xsd:int | xsd:integer | xsd:long | xsd:negativeInteger | xsd:nonNegativeInteger | xsd:nonPositiveInteger | xsd:positiveInteger | xsd:short | xsd:unsignedByte | xsd:unsignedInt | xsd:unsignedLong | xsd:unsignedShort | owl:rational | owl:real)"
      ],
