    {
      "name": "Building",
      "definition_uri": "https://w3id.org/lmodel/gist/Building",
      "annotations": [
        {
          "tag": "owl:deprecated",
          "value": true,
          "@type": "Annotation"
        }
      ],
      "description": "A relatively permanent man-made structure situated on a plot of land, having a roof and walls, commonly used for dwelling, entertaining, or working.",
      "title": "Building",
      "deprecated": "gist marks this term owl:deprecated.",
      "comments": [
        "User discretion can be applied to edge cases: e.g., is a traditional yurt 'relatively permanently situated' although it is portable and has a tent-like construction?"
      ],
      "examples": [
        {
          "value": "A house, school, store, factory, chicken coop.",
          "@type": "Example"
        },
        {
          "value": "Negative examples: houseboats (not built on land), caves (not man-made), food trucks and RVs (not permanently situated).",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
