      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/semanticarts/ns/ontology/gist/GovernmentOrganization",
      "disjoint_with": [
        "IntergovernmentalOrganization"
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "HistoricalEvent",
      "definition_uri": "https://w3id.org/lmodel/gist/HistoricalEvent",
      "description": "An event which occurred in time, with an actual end earlier than the present moment.",
      "notes": [
        "OWL subClassOf restrictions: \u2203actualStartDateTime.xsd:dateTime",
        "OWL equivalentClass: (gist:Event & \u2203actualEndDateTime.xsd:dateTime)"
      ],
      "in_subset": [
