      "name": "Function",
      "definition_uri": "https://w3id.org/lmodel/gist/Function",
      "description": "The activity that a human-made item is intended to perform.",
      "examples": [
        {
          "value": "Transmit electricity, provide ballast, control ambient temperature.",
          "@type": "Example"
        }
      ],
      "in_subset": [
