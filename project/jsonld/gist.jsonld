      ],
      "description": "The subject is consistent with or satisfies the requirements, rules, or expectations established by the object.",
      "title": "conforms to",
      "examples": [
        {
          "value": "Meet an obligation; adhere to a specification or standard; meet terms and conditions of an offer; comply with a regulation.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
