      "annotations": [
        {
          "tag": "range_includes",
          "value": "gist:Collection, gist:Organization",
          "@type": "Annotation"
        }
      ],
      "description": "Relates a member individual to the thing, such as a collection or organization, that it is a member of.",
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
