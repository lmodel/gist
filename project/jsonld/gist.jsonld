      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ElectronicAddressType",
      "definition_uri": "https://w3id.org/lmodel/gist/ElectronicAddressType",
      "description": "A category indicating a kind of electronic address. Such a category is usually based on the technology that enables routing to the address referent.",
      "examples": [
        {
          "value": "A URL, file system path, email address, mobile telephone number.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
