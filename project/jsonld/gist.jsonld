    {
      "name": "planned_end_date",
      "definition_uri": "https://w3id.org/lmodel/gist/planned_end_date",
      "description": "The date that something is or was planned to end, with precision of one day.",
      "title": "planned end date",
      "comments": [
        "Used for anything with a planned end date, such as when a lease will expire, when an offer is no longer available, etc. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision."
      ],
      "examples": [
        {
          "value": "'2021-06-01T00:00:00-06:00'^^xsd:dateTime",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/plannedEndDate"
      ],
      "is_a": "planned_end_date_time",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/plannedEndDate",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "datetime",
      "@type": "SlotDefinition"
    },
    {
      "name": "planned_end_date_time",
      "definition_uri": "https://w3id.org/lmodel/gist/planned_end_date_time",
      "description": "The date that something is or was planned to end, with no implied precision.",
      "title": "planned end date time",
      "comments": [
        "This is an abstraction over the various precisions of planned end time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.",
        "This property, unlike gist:actualEndDateTime, does not have a subproperty for microsecond precision, because planned times typically are not expressed at that level of granularity. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/plannedEndDateTime"
      ],
      "is_a": "end_date_time",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/plannedEndDateTime",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "datetime",
      "@type": "SlotDefinition"
    },
    {
      "name": "planned_end_minute",
      "definition_uri": "https://w3id.org/lmodel/gist/planned_end_minute",
      "description": "The date and time that something is or was planned to end, with precision of one minute.",
      "title": "planned end minute",
      "comments": [
        "Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual."
      ],
      "examples": [
        {
          "value": "'2021-06-01T08:32:00-06:00'^^xsd:dateTime",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/plannedEndMinute"
      ],
      "is_a": "planned_end_date_time",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/plannedEndMinute",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "datetime",
      "@type": "SlotDefinition"
    },
    {
      "name": "planned_end_year",
      "definition_uri": "https://w3id.org/lmodel/gist/planned_end_year",
      "description": "The date that something is or was planned to end, with precision of one year.",
      "title": "planned end year",
      "comments": [
        "Used for anything with a planned end date where precision of one year is sufficient. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included."
      ],
      "examples": [
        {
          "value": "'2021-01-01T00:00:00-06:00'^^xsd:dateTime",
          "@type": "Example"
        },
        {
          "value": "The automobile manufacturer announced that it will stop producing gas-powered vehicles in 2035.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/plannedEndYear"
      ],
      "is_a": "planned_end_date_time",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/plannedEndYear",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "datetime",
      "@type": "SlotDefinition"
    },
    {
      "name": "planned_start_date",
      "definition_uri": "https://w3id.org/lmodel/gist/planned_start_date",
      "description": "The date that something is or was planned to start, with precision of one day.",
      "title": "planned start date",
      "comments": [
        "Used for anything with a planned start date, such as when a lease will start, when a configuration becomes available, etc. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision."
      ],
      "examples": [
        {
          "value": "'2021-06-01T00:00:00-06:00'^^xsd:dateTime",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDate"
      ],
      "is_a": "planned_start_date_time",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDate",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "datetime",
      "@type": "SlotDefinition"
    },
    {
      "name": "planned_start_date_time",
      "definition_uri": "https://w3id.org/lmodel/gist/planned_start_date_time",
      "description": "The date and time that something is or was planned to start, with no implied precision.",
      "title": "planned start date time",
      "comments": [
        "This is an abstraction over the various precisions of planned start time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.",
        "This property, unlike gist:actualStartDateTime, does not have a subproperty for microsecond precision, because planned times typically are not expressed at that level of granularity. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDateTime"
      ],
      "is_a": "start_date_time",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDateTime",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "datetime",
      "@type": "SlotDefinition"
    },
    {
      "name": "planned_start_minute",
      "definition_uri": "https://w3id.org/lmodel/gist/planned_start_minute",
      "description": "The date and time that something is or was planned to start, with precision of one minute.",
      "title": "planned start minute",
      "comments": [
        "Used for things like meetings and time card entries, where the hour and minute are important. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision."
      ],
      "examples": [
        {
          "value": "'2021-06-01T08:32:00-06:00'^^xsd:dateTime",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/plannedStartMinute"
      ],
      "is_a": "planned_start_date_time",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/plannedStartMinute",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "datetime",
      "@type": "SlotDefinition"
    },
    {
      "name": "planned_start_year",
      "definition_uri": "https://w3id.org/lmodel/gist/planned_start_year",
      "description": "The date that something is or was planned to start, with precision of one year.",
      "title": "planned start year",
      "comments": [
        "Used for anything with a planned start date where precision of one year is sufficient. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included."
      ],
      "examples": [
        {
          "value": "'2021-01-01T00:00:00-06:00'^^xsd:dateTime",
          "@type": "Example"
        },
        {
          "value": "The automobile manufacturer announced that its full line-up will include only electric cars starting in 2035.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/plannedStartYear"
      ],
      "is_a": "planned_start_date_time",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/plannedStartYear",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "datetime",
      "@type": "SlotDefinition"
    },
    {
      "name": "sequence",
      "definition_uri": "https://w3id.org/lmodel/gist/sequence",
      "annotations": [
        {
          "tag": "domain_includes",
          "value": "gist:OrderedMember",
          "@type": "Annotation"
        }
      ],
      "description": "A number that specifies the position of an element within a series.",
      "title": "sequence",
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/sequence"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/sequence",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "start_date_time",
      "definition_uri": "https://w3id.org/lmodel/gist/start_date_time",
      "description": "The date and time that something starts.",
      "title": "start date time",
      "comments": [
        "This property is neutral along two dimensions: precision (e.g., day, second, millisecond) and actual vs. planned. As such, it will generally not be asserted directly except in special cases (e.g., for time intervals).",
        "Values of predicates with different precisions can be compared since they are all formally xsd:datetimes."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/startDateTime"
      ],
      "is_a": "at_date_time",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/startDateTime",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "datetime",
      "@type": "SlotDefinition"
    },
    {
      "name": "symbol",
      "definition_uri": "https://w3id.org/lmodel/gist/symbol",
      "annotations": [
        {
          "tag": "domain_includes",
          "value": "gist:UnitOfMeasure",
          "@type": "Annotation"
        }
      ],
      "description": "A symbol for something using only ASCII characters.",
      "title": "symbol",
      "examples": [
        {
          "value": "The ASCII symbol for square meter is m^2.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/symbol"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/symbol",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "unique_text",
      "definition_uri": "https://w3id.org/lmodel/gist/unique_text",
      "annotations": [
        {
          "tag": "domain_includes",
          "value": "gist:ID, gist:MediaType, gist:Tag, gist:Text",
          "@type": "Annotation"
        }
      ],
      "description": "The unique string value of some content object, to be used when there is no possibility of having more than one value.",
      "title": "unique text",
      "comments": [
        "Note that the uniqueness only goes in one direction: a product catalog number might also be an employee ID."
      ],
      "examples": [
        {
          "value": "The unique string for a vehicle identification number.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/uniqueText"
      ],
      "is_a": "contained_text",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/uniqueText",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "domain_includes",
      "definition_uri": "https://w3id.org/lmodel/gist/domain_includes",
      "implements": [
        "owl:AnnotationProperty"
      ],
      "description": "Relates a property to a class that the property is expected to be used on.",
      "title": "domain includes",
      "comments": [
        "There may be multiple domainIncludes assertions on a single property.",
        "This property is used to guide the ontology user; like all annotation properties, it does not play a role in inference."
      ],
      "examples": [
        {
          "value": "The domain of the property gist:containedText includes gist:Tag and gist:Text.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/domainIncludes"
      ],
      "broad_mappings": [
        "http://www.w3.org/2004/02/skos/core#scopeNote"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/domainIncludes",
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "is_superseded_by",
      "definition_uri": "https://w3id.org/lmodel/gist/is_superseded_by",
      "implements": [
        "owl:AnnotationProperty"
      ],
      "description": "Relates a deprecated term to a term that replaces it, which is either an exact (in the case of simple renaming) or approximate (in the case of renaming and some semantic change) semantic match.",
      "title": "is superseded by",
      "examples": [
        {
          "value": "gist:connectedTo was superseded by gist:isConnectedTo (renaming with no semantic change).",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/isSupersededBy"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/isSupersededBy",
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "license",
      "definition_uri": "https://w3id.org/lmodel/gist/license",
      "implements": [
        "owl:AnnotationProperty"
      ],
      "description": "Relates something to its conditions of use.",
      "title": "license",
      "comments": [
        "Could refer to a license object by URI or name or could consist of the license text itself."
      ],
      "examples": [
        {
          "value": "The gist ontology is licensed under the CC By 4.0 license.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/license"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/license",
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "range_includes",
      "definition_uri": "https://w3id.org/lmodel/gist/range_includes",
      "implements": [
        "owl:AnnotationProperty"
      ],
      "description": "Relates a property to a class that is an expected type of its values.",
      "title": "range includes",
      "comments": [
        "There may be multiple rangeIncludes assertions on a single property.",
        "This property is used to guide the ontology user; like all annotation properties, it does not play a role in inference."
      ],
      "examples": [
        {
          "value": "The range of the property gist:isCategorizedBy includes gist:Category.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/rangeIncludes"
      ],
      "broad_mappings": [
        "http://www.w3.org/2004/02/skos/core#scopeNote"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/rangeIncludes",
      "range": "string",
      "@type": "SlotDefinition"
    }
  ],
