      "@type": "SlotDefinition"
    },
    {
      "name": "has_participant",
      "definition_uri": "https://w3id.org/lmodel/gist/has_participant",
      "description": "Relates something (e.g. an agreement) to things that play a role, or take part or are otherwise involved in some way.",
      "comments": [
        "The thing with participants will often be an agreement, event or obligation. Participation does not imply agency.",
        "This will most often be used as an abstract property. Use subproperties that indicate the nature of the participation (e.g. hasBorrower, hasVenue)."
      ],
      "examples": [
        {
          "value": "An event of transferring money has a participating account that receives the money.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "has participant"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant",
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "has_party",
      "definition_uri": "https://w3id.org/lmodel/gist/has_party",
      "description": "Relates an event, agreement, or obligation to a participating person or organization.",
      "comments": [
        "Subproperties may be defined to describe specific parties, such as hasLender and hasBorrower for a loan."
      ],
      "examples": [
        {
          "value": "Loan agreements have lender and borrower parties.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "has party"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/hasParty"
      ],
      "is_a": "has_participant",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/hasParty",
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "any_of": [
        {
          "range": "Organization",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "Person",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "has_physical_location",
      "definition_uri": "https://w3id.org/lmodel/gist/has_physical_location",
      "description": "Relates something to its physical location.",
      "comments": [
        "This property does not distinguish between things whose locations are stable and those whose locations change over time; e.g., a fire hydrant vs. a car."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "has physical location"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/hasPhysicalLocation"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/hasPhysicalLocation",
      "transitive": true,
      "range": "GeoLocation",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "has_recipient",
      "definition_uri": "https://w3id.org/lmodel/gist/has_recipient",
      "description": "Relates something to the participant that receives or is intended to receive it.",
      "comments": [
        "This property is used in abstract contexts such as agreements, obligations, contracts, etc., whereas gist:goesToAgent is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another. However, there are contexts in which either may be appropriate, such as the giving of a gift."
      ],
      "examples": [
        {
          "value": "An offer is made to a recipient; an obligation has a recipient to whom another person is obligated; a gift is bestowed upon a recipient.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "has recipient"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/hasRecipient"
      ],
      "is_a": "has_participant",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/hasRecipient",
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "has_subtrahend",
      "definition_uri": "https://w3id.org/lmodel/gist/has_subtrahend",
      "description": "Relates an aspect to another aspect that is a subtracted component of it.",
      "comments": [
        "Commonly used with financial metrics."
      ],
      "examples": [
        {
          "value": "In the equation 'profit = revenue - expenses', revenue is an addend and expenses is a subtrahend.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
