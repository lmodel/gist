      "owner": "is_expressed_in",
      "range": "Language",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "is_first_member_of",
      "definition_uri": "https://w3id.org/lmodel/gist/is_first_member_of",
      "description": "Relates the first member of an ordered collection to the collection.",
      "comments": [
        "Given the Open World Assumption, the absence of a predecessor does not entail that an ordered member is the first member of an ordered collection. This property is used to explicitly indicate the first member. Since ordered collections need not be strictly ordered, there can be more than one first member."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "is first member of"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/isFirstMemberOf"
      ],
      "is_a": "is_member_of",
      "domain": "OrderedMember",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/isFirstMemberOf",
      "owner": "is_first_member_of",
      "range": "OrderedCollection",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "is_geo_contained_in",
      "definition_uri": "https://w3id.org/lmodel/gist/is_geo_contained_in",
