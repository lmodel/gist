    {
      "name": "Offer",
      "definition_uri": "https://w3id.org/lmodel/gist/Offer",
      "description": "A contingent commitment to buy, sell, swap or provide one or more described or identified goods or services in exchange for another (or others).",
      "title": "Offer",
      "notes": [
        "OWL equivalentClass: (gist:ContingentObligation & \u2203hasGiver.(gist:Organization | gist:Person) & \u2203offersToProvide.owl:Thing & \u2203offersToReceive.owl:Thing & \u2203plannedEndDateTime.xsd:dateTime & \u2203plannedStartDateTime.xsd:dateTime)"
      ],
      "comments": [
        "Dates on an offer represent the time period the offer is valid for, as in '25% off through October 25, 2025.'"
      ],
      "examples": [
        {
          "value": "An offer to sell a book for a given price; an offer to purchase real estate for a particular price; an offer to swap a sea kayak for a mountain bike; currency exchange. A donation may be modeled as an offer to receive money typically in exchange for $0.00, but sometimes for items of value such as coffee mugs or T-shirts.",
          "@type": "Example"
        }
      ],
      "in_subset": [
