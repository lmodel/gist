      "is_a": "at_date_time",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/isRecordedAt",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "datetime",
      "@type": "SlotDefinition"
    },
