    {
      "name": "has_unit_of_measure",
      "definition_uri": "https://w3id.org/lmodel/gist/has_unit_of_measure",
      "description": "Relates a magnitude to its unit of measure.",
      "examples": [
        {
          "value": "The magnitude 87 inches of height has unit of measure inches.",
          "@type": "Example"
        }
      ],
      "in_subset": [
