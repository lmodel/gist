    {
      "name": "GovernedGeoRegion",
      "definition_uri": "https://w3id.org/lmodel/gist/GovernedGeoRegion",
      "description": "A geographic region governed by at least one government organization.",
      "title": "Governed Geographic Region",
      "notes": [
        "OWL equivalentClass: (gist:GeoRegion & \u2203isGovernedBy.gist:GovernmentOrganization)"
