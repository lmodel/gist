    },
    {
      "name": "exponent_of_second",
      "definition_uri": "https://w3id.org/lmodel/gist/exponent_of_second",
      "description": "The exponent of second in a product of powers of base units.",
      "notes": [
        "OWL domain: (gist:UnitGroup | gist:UnitOfMeasure)"
      ],
      "examples": [
        {
          "value": "In the equation '1 watt-hour = 3600 x kilogram meterSquared per secondSquared'\r\n\r\n\t\tthe conversion factor for watt-hour is 3600\r\n\t\tthe exponent of kilogram is 1\r\n\t\tthe exponent of meter is 2\r\n\t\tthe exponent of second is -2\r\n\t\tall other exponents are zero\r\n\r\n\t\tEvery member of a unit group containing watt-hour must be a multiple of kilogram meterSquared per secondSquared.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "exponent of second"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfSecond"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfSecond",
      "range": "decimal",
      "@type": "SlotDefinition"
    },
    {
      "name": "exponent_of_steradian",
      "definition_uri": "https://w3id.org/lmodel/gist/exponent_of_steradian",
      "description": "The exponent of steradian in a product of powers of base units.",
      "notes": [
        "OWL domain: (gist:UnitGroup | gist:UnitOfMeasure)"
      ],
      "comments": [
        "Steradian is a measure of solid angle."
      ],
      "examples": [
        {
          "value": "In the equation '1 watt per square meter steradian = 1 x kilogram per secondCubed steradian'\r\n\r\n\t\tthe conversion factor for watt per square meter steradian is 1\r\n\t\tthe exponent of kilogram is 1\r\n\t\tthe exponent of second is -3\r\n\t\tthe exponent of steradian is -1\r\n\t\tall other exponents are zero\r\n\r\n\t\tEvery member of a unit group containing watt per square meter steradian must a multiple of kilogram per secondCubed steradian.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
