    },
    {
      "name": "is_direct_part_of",
      "definition_uri": "https://w3id.org/lmodel/gist/is_direct_part_of",
      "description": "The relationship between a part and a whole where the part has independent existence and there are no other parts in between.",
      "comments": [
        "Because the part has independent existence, there is no cascading delete.",
        "It is safest to use this property when semantic directness is inherent in the relationship, rather than simply expressing a chosen granularity. For example, a spark plug is a direct part of an engine block; there cannot be any intermediate parts. Otherwise, there is a risk of making an isDirectPartOf assertion and then later inserting an intermediate part; this will result in making an asserted triple false even though there was no change in the world. When in doubt, use the transitive version gist:isPartOf."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "is direct part of"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf"
      ],
      "is_a": "is_part_of",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf",
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "is_expressed_in",
      "definition_uri": "https://w3id.org/lmodel/gist/is_expressed_in",
      "annotations": [
        {
          "tag": "domain_includes",
          "value": "gist:Text",
          "@type": "Annotation"
        },
        {
          "tag": "range_includes",
          "value": "gist:Language",
          "@type": "Annotation"
        }
      ],
      "description": "Relates something to the language it is expressed in.",
