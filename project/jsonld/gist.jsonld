        "https://w3id.org/semanticarts/ns/ontology/gist/hasBroader"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/hasBroader",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "transitive": true,
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "has_direct_broader",
      "definition_uri": "https://w3id.org/lmodel/gist/has_direct_broader",
      "description": "Relates a thing to another thing with a broader meaning, when there is no intermediate between them.",
      "title": "has direct broader",
      "comments": [
        "Unlike gist:hasBroader, this property is not transitive. It is safest to use this property when semantic directness is inherent in the relationship. Otherwise, there is a risk of making a hasDirectBroader assertion and then later inserting an intermediate part; this will result in making an asserted triple false even though there was no change in the world. When in doubt, use the transitive version gist:hasBroader."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/hasDirectBroader"
      ],
      "is_a": "has_broader",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/hasDirectBroader",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "has_divisor",
      "definition_uri": "https://w3id.org/lmodel/gist/has_divisor",
      "description": "Relates a unit of measure to another unit of measure that is a divisor, or relates an aspect to another aspect that is a divisor.",
      "title": "has divisor",
      "comments": [
        "Provides a supplemental method of decomposing a unit of measure or an aspect into component factors. Enables dimensional analysis such as miles per hour x hours = miles."
      ],
      "examples": [
        {
          "value": "Miles per hour has miles as a multiplier and hour as a divisor; speed has distance as a multiplier and duration as a divisor.",
