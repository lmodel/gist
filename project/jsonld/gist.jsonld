      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/semanticarts/ns/ontology/gist/HistoricalEvent",
      "@type": "ClassDefinition"
    },
    {
      "name": "ID",
      "definition_uri": "https://w3id.org/lmodel/gist/ID",
      "description": "Content that is used to uniquely identify something or someone.",
      "notes": [
        "OWL equivalentClass: (gist:Content & \u2203isAllocatedBy.(gist:IntellectualProperty | gist:Organization | gist:Person) & \u2203uniqueText.xsd:string)"
      ],
      "comments": [
        "Used in conjunction with gist:isIdentifiedBy."
      ],
      "examples": [
        {
          "value": "SSN for a person; serial number for a product; employee ID for a person.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "ID"
      ],
      "mappings": [
        "gist:ID"
      ],
      "close_mappings": [
        "common_domain_model:Identifier",
        "common_domain_model:AssignedIdentifier"
      ],
      "narrow_mappings": [
        "common_domain_model:PartyIdentifier",
        "common_domain_model:PersonIdentifier",
        "common_domain_model:EntityIdentifier"
      ],
      "is_a": "Content",
      "slots": [
        "name",
        "description"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/semanticarts/ns/ontology/gist/ID",
      "@type": "ClassDefinition"
    },
    {
      "name": "IntellectualProperty",
      "definition_uri": "https://w3id.org/lmodel/gist/IntellectualProperty",
      "description": "An intangible work, invention, or concept, independent of its being expressed in text, audio, video, image, or live performance. IP can also be tacit knowledge, know-how, or skill.",
      "comments": [
        "For literature this could be called the 'Work,' except that 'work' is a highly overloaded term (expenditure of energy, resource consumption, art). Often the first expression precedes our recognition of the IP, but subsequent expressions are known to be derivatives of the IP, even if they are expression-to-expression translations (or copies).",
        "This concept includes works that are out of copyright or were never formally registered; the defining feature is not that it is legally protected but that it is an intangible creation of the human mind."
      ],
      "examples": [
        {
          "value": "The Old Man and The Sea; the Page Rank algorithm; the brand Coca Cola.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "Intellectual Property"
      ],
      "mappings": [
        "gist:IntellectualProperty"
      ],
      "related_mappings": [
        "dpv:IntellectualPropertyData"
      ],
      "mixins": [
        "GistThing"
      ],
      "slots": [
        "name",
        "description"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/semanticarts/ns/ontology/gist/IntellectualProperty",
      "disjoint_with": [
        "Magnitude",
        "Organization",
        "PhysicalIdentifiableItem",
        "PhysicalSubstance",
        "UnitOfMeasure"
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Intention",
      "definition_uri": "https://w3id.org/lmodel/gist/Intention",
      "description": "A goal, desire, or aspiration.",
      "comments": [
        "The 'teleological' aspect of a system that indicates things are done with a purpose."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "Intention"
      ],
      "mappings": [
        "gist:Intention"
      ],
      "mixins": [
        "GistThing"
      ],
      "slots": [
        "name",
        "description"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/semanticarts/ns/ontology/gist/Intention",
      "disjoint_with": [
