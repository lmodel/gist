      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/hasGiver",
      "disjoint_with": [
        "has_recipient"
      ],
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "has_goal",
      "definition_uri": "https://w3id.org/lmodel/gist/has_goal",
      "description": "Relates something to the end towards which it directs effort.",
      "examples": [
        {
          "value": "The sales division of a company has the goal of acquiring new customers and contracts.",
