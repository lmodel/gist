      "definition_uri": "https://w3id.org/lmodel/gist/offers_to_provide",
      "annotations": [
        {
          "tag": "domain_includes",
          "value": "gist:Offer",
          "@type": "Annotation"
        }
      ],
      "description": "Relates an offer to the thing being made available for exchange.",
      "title": "offers to provide",
      "comments": [
        "This will most often be a good or service, but could be an amount of money, e.g., for currency exchange."
      ],
      "examples": [
        {
          "value": "An offer to provide a specific product in exchange for an amount of money or to pay a certain price for a home that is for sale.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
