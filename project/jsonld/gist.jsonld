    },
    {
      "name": "is_part_of",
      "definition_uri": "https://w3id.org/lmodel/gist/is_part_of",
      "description": "The relationship between a part and a whole where the part has independent existence.",
      "comments": [
        "Because the part has independent existence, there is no cascading delete.",
        "The transitive version of gist:isDirectPartOf."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "is part of"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/isPartOf"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/isPartOf",
      "transitive": true,
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "is_produced_by",
      "definition_uri": "https://w3id.org/lmodel/gist/is_produced_by",
      "description": "Relates something to the thing that created, composed, or brought it into existence.",
      "examples": [
        {
          "value": "A deliverable is produces by a task.",
          "@type": "Example"
        },
        {
          "value": "A measurement is produced by a sensor.",
          "@type": "Example"
        },
        {
          "value": "A painting is produced by a person.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "is produced by"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/isProducedBy"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/isProducedBy",
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "is_recognized_by",
      "definition_uri": "https://w3id.org/lmodel/gist/is_recognized_by",
      "description": "Relates something to a party that formally acknowledges its existence, validity, or legality.",
      "examples": [
        {
          "value": "The existence of a particular company is recognized by the state.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "is recognized by"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/isRecognizedBy"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/isRecognizedBy",
      "range": "string",
      "multivalued": true,
      "any_of": [
        {
          "range": "Organization",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "Person",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "is_rendered_on",
      "definition_uri": "https://w3id.org/lmodel/gist/is_rendered_on",
      "description": "Relates content to the media on which it is rendered.",
      "examples": [
        {
          "value": "A document is rendered on a computer screen; a piece of music is rendered through speakers.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "is rendered on"
      ],
      "mappings": [
