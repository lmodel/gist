    },
    {
      "name": "is_connected_to",
      "definition_uri": "https://w3id.org/lmodel/gist/is_connected_to",
      "description": "A non-owning, non-causal, non-subordinate (i.e., peer-to-peer) relationship.",
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "is connected to"
