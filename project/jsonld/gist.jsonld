      "name": "RenderedContent",
      "definition_uri": "https://w3id.org/lmodel/gist/RenderedContent",
      "description": "Content expressed via some physical medium.",
      "notes": [
        "OWL equivalentClass: (gist:FormattedContent & \u2203isRenderedOn.gist:Medium)"
      ],
      "comments": [
        "Renderings of the same file on two different monitors are separate instances of rendered content."
      ],
      "examples": [
        {
          "value": "Words printed on paper; audio played on speakers; an image displayed on a monitor; an original painting.",
          "@type": "Example"
        }
      ],
