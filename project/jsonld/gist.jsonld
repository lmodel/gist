    {
      "name": "has_navigational_parent",
      "definition_uri": "https://w3id.org/lmodel/gist/has_navigational_parent",
      "description": "Relates a child category to a parent category in an informal (e.g., faceted) hierarchy.",
      "examples": [
        {
          "value": "Refrigerator handles are not refrigerators, but it may be useful to represent their relationship hierarchically for a faceted UI filter.",
