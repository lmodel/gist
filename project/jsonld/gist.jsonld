      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "disjoint_with": [
        "has_recipient"
      ],
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
