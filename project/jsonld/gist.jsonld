      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/exponentOfSteradian",
      "range": "decimal",
      "@type": "SlotDefinition"
    },
    {
      "name": "exponent_of_us_dollar",
      "definition_uri": "https://w3id.org/lmodel/gist/exponent_of_us_dollar",
      "description": "The exponent of US Dollar in a product of powers of base units.",
      "notes": [
        "OWL domain: (gist:UnitGroup | gist:UnitOfMeasure)"
      ],
      "comments": [
        "The factors for converting from one currency to another change constantly."
      ],
      "examples": [
        {
          "value": "In the equation '1 million dollars per week = 1.65344 x dollar per second'\r\n\r\n\t\tthe conversion factor for million dollars per week is 1.65344\r\n\t\tthe exponent of US Dollar is 1\r\n\t\tthe exponent of second is -1\r\n\t\tall other exponents are zero\r\n\r\n\t\tEvery member of a unit group containing million dollars per week must be a multiple of dollar per second.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
