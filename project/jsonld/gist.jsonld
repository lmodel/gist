    {
      "name": "GeoRoute",
      "definition_uri": "https://w3id.org/lmodel/gist/GeoRoute",
      "description": "An ordered set of geographic points that defines a path from a starting point to an ending point.",
      "title": "Geographic Route",
      "notes": [
        "OWL equivalentClass: (gist:OrderedCollection & \u2203^isMemberOf.gist:GeoPoint)"
      ],
      "comments": [
