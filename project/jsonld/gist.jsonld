    {
      "name": "is_allocated_by",
      "definition_uri": "https://w3id.org/lmodel/gist/is_allocated_by",
      "annotations": [
        {
          "tag": "domain_includes",
          "value": "gist:Category, gist:ID",
          "@type": "Annotation"
        }
      ],
      "description": "Relates something to whomever or whatever assigns or distributes it.",
      "comments": [
        "The allocator may be a person, organization, or automated process."
      ],
      "examples": [
        {
          "value": "A U.S. Social Security number is allocated by the U.S. Social Security Administration; the media type https://www.iana.org/assignments/media-types/text/csv is allocated by the Internet Assigned Numbers Authority (IANA).",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "is allocated by"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/isAllocatedBy"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/isAllocatedBy",
      "range": "string",
      "multivalued": true,
      "any_of": [
        {
          "range": "IntellectualProperty",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "Organization",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "Person",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "is_assignment_of",
      "definition_uri": "https://w3id.org/lmodel/gist/is_assignment_of",
      "annotations": [
        {
          "tag": "domain_includes",
          "value": "gist:Assignment",
          "@type": "Annotation"
        },
        {
          "tag": "range_includes",
          "value": "gist:Equipment, gist:IntellectualProperty, gist:Organization, gist:Person",
          "@type": "Annotation"
        }
      ],
      "description": "Relates an assignment to the resource it assigns.",
      "comments": [
        "People, organizations, monetary amounts, equipment can all be assigned.",
        "While typically this predicate will be used with assignment subjects, there may be other use cases, and therefore a domain is not specified."
      ],
      "examples": [
        {
          "value": "Assignment of a person to a project.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "is assignment of"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentOf"
      ],
      "domain": "Assignment",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentOf",
      "owner": "is_assignment_of",
      "range": "string",
      "multivalued": true,
      "any_of": [
        {
          "range": "Equipment",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "IntellectualProperty",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "Organization",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "Person",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "is_assignment_to",
      "definition_uri": "https://w3id.org/lmodel/gist/is_assignment_to",
      "annotations": [
        {
          "tag": "domain_includes",
          "value": "gist:Assignment",
          "@type": "Annotation"
        }
      ],
      "description": "Relates something (typically an assignment) to the thing the resource is assigned to, such as a project, position, organization, pay rate, or billing rate.",
      "comments": [
        "While typically this predicate will be used with gist:Assignment subjects, there may be other use cases, and therefore a domain is not specified."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "is assignment to"
      ],
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentTo"
      ],
      "domain": "Assignment",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentTo",
      "owner": "is_assignment_to",
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "is_based_on",
      "definition_uri": "https://w3id.org/lmodel/gist/is_based_on",
      "description": "The object is a foundation for, a starting point for, gave rise to, or justifies the subject.",
      "examples": [
        {
          "value": "A document is based on a document template; a metric computing the average income of a population is based on the metric for individual income.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
