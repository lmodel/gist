      "disjoint_with": [
        "UnitOfMeasure"
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ServiceSpecification",
      "definition_uri": "https://w3id.org/lmodel/gist/ServiceSpecification",
      "description": "A description of something that can be done for a person or organization (which produces some form of an act).",
      "notes": [
        "OWL equivalentClass: (gist:CatalogItem & \u2203^isBasedOn.gist:Event)"
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "Service Specification"
      ],
