    {
      "name": "Event",
      "definition_uri": "https://w3id.org/lmodel/gist/Event",
      "description": "Something that occurs over a period of time, often characterized as an activity being carried out by some person, organization, or software application or brought about by natural forces.",
      "title": "Event",
      "comments": [
        "An event does not necessarily have either planned or actual start or end datetimes. For example, a conference can be in the planning phase without any dates selected, but is nevertheless an (unscheduled) event. The subclasses of gist:Event state particular restrictions on planned and actual start and end dates.",
        "An event occurs during a time interval, which is distinct from the event."
      ],
      "examples": [
        {
          "value": "A transaction, conference, baseball game, earthquake.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "exact_mappings": [
        "gist:Event"
      ],
      "narrow_mappings": [
        "common_domain_model:BusinessEvent",
