    {
      "name": "has_broader",
      "definition_uri": "https://w3id.org/lmodel/gist/has_broader",
      "description": "Relates a thing to another thing with a broader meaning.",
      "title": "has broader",
      "examples": [
        {
          "value": "The aspect distance is broader than the aspect height.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
