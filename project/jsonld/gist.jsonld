        "name",
        "description"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/semanticarts/ns/ontology/gist/GeoVolume",
      "@type": "ClassDefinition"
    },
    {
      "name": "GovernedGeoRegion",
      "definition_uri": "https://w3id.org/lmodel/gist/GovernedGeoRegion",
      "description": "A geographic region governed by at least one government organization.",
      "notes": [
        "OWL equivalentClass: (gist:GeoRegion & \u2203isGovernedBy.gist:GovernmentOrganization)"
      ],
      "comments": [
        "Geographic regions do not need not be physically contiguous in order to constitute a governed geographic region; e.g., Alaska and Hawaii are part of the region governed by the United States."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "Governed Geographic Region"
      ],
      "mappings": [
        "gist:GovernedGeoRegion"
      ],
      "is_a": "GeoRegion",
      "slots": [
        "name",
