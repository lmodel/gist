    },
    {
      "name": "ElectronicAddress",
      "definition_uri": "https://w3id.org/lmodel/gist/ElectronicAddress",
      "description": "An address referring to a locatable virtual place that does not physically exist but is made by software or electronics to appear to do so.",
      "examples": [
        {
          "value": "A file system path, website URL, IP address, email address, mobile or landline telephone number.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "Electronic Address",
        "Virtual Address"
      ],
      "mappings": [
        "gist:ElectronicAddress"
      ],
      "related_mappings": [
        "common_domain_model:ContactInformation"
      ],
      "is_a": "Address",
      "slots": [
