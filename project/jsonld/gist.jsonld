    },
    {
      "name": "ScheduledEvent",
      "definition_uri": "https://w3id.org/lmodel/gist/ScheduledEvent",
      "description": "An event with a planned start datetime.",
      "notes": [
        "OWL equivalentClass: (gist:Event & \u2203plannedStartDateTime.xsd:dateTime)"
      ],
      "comments": [
        "If the event already started, but has not yet ended, it is a contemporary event with an actual start datetime. If the event is over, it is a historical event having an actual end datetime. The event always retains its planned start datetime, and thus continues to be a scheduled event."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "Scheduled Event"
      ],
      "mappings": [
        "gist:ScheduledEvent"
      ],
      "related_mappings": [
        "common_domain_model:Schedule"
      ],
      "is_a": "Event",
      "slots": [
        "name",
        "description"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/semanticarts/ns/ontology/gist/ScheduledEvent",
      "@type": "ClassDefinition"
    },
    {
      "name": "ScheduledTask",
      "definition_uri": "https://w3id.org/lmodel/gist/ScheduledTask",
      "description": "A task with a planned start datetime.",
      "notes": [
        "Additional named superclasses (modelled as OWL multiple inheritance): Task",
        "OWL equivalentClass: (gist:ScheduledEvent & gist:Task)"
      ],
      "comments": [
        "If work on the task has already started, but has not yet ended, it will have an actual start datetime. If the task is completed, it will also have an actual end datetime. The task always retains its planned start time, and thus continues to be a scheduled task."
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
        "Scheduled Task"
      ],
      "mappings": [
        "gist:ScheduledTask"
      ],
      "is_a": "ScheduledEvent",
      "slots": [
        "name",
        "description"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/semanticarts/ns/ontology/gist/ScheduledTask",
      "@type": "ClassDefinition"
    },
    {
      "name": "SchemaMetaData",
      "definition_uri": "https://w3id.org/lmodel/gist/SchemaMetaData",
      "description": "Superclass for all types of metadata.",
      "deprecated": "true",
      "comments": [
        "The definition of this class needs additional work."
      ],
      "examples": [
        {
          "value": "Relational concepts, such as tables and columns; tool inputs, such as queries and R2RML maps.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "aliases": [
