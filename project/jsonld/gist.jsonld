      "name": "ScheduledEvent",
      "definition_uri": "https://w3id.org/lmodel/gist/ScheduledEvent",
      "description": "An event with a planned start datetime.",
      "title": "Scheduled Event",
      "notes": [
        "OWL equivalentClass: (gist:Event & \u2203plannedStartDateTime.xsd:dateTime)"
      ],
      "comments": [
        "If the event already started, but has not yet ended, it is a contemporary event with an actual start datetime. If the event is over, it is a historical event having an actual end datetime. The event always retains its planned start datetime, and thus continues to be a scheduled event."
      ],
