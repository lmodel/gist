  "slots": [
    {
      "name": "allows",
      "definition_uri": "https://w3id.org/lmodel/gist/allows",
      "description": "Relates a permission to a particular activity or type of activity it allows.",
      "title": "allows",
      "examples": [
        {
          "value": "An easement grants a right to cross or otherwise use someone else's land for a specified purpose.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/allows"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/allows",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "comes_from_agent",
      "definition_uri": "https://w3id.org/lmodel/gist/comes_from_agent",
      "description": "Relates something to the originating agent.",
      "title": "comes from agent",
      "comments": [
        "This is not the inverse of gist:goesToAgent, as both properties have the message or shipment as the subject.",
        "This property is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another, whereas gist:hasGiver is typically used in more abstract contexts such as agreements, obligations, contracts, etc. However, there are contexts in which either may be appropriate, such as the giving of a gift."
      ],
      "examples": [
        {
          "value": "A package is shipped by a person; a purchase order is emailed to a vendor by an organization.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/comesFromAgent"
      ],
      "is_a": "has_participant",
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/comesFromAgent",
      "owner": "GistThing",
      "domain_of": [
        "GistThing"
      ],
      "range": "Any",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "any_of": [
        {
          "range": "Organization",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "Person",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "comes_from_place",
      "definition_uri": "https://w3id.org/lmodel/gist/comes_from_place",
      "description": "Relates something to its place of origin.",
      "title": "comes from place",
      "examples": [
        {
          "value": "A letter has a return address indicating its origin; a delivery route originates at a distribution center; a trail originates at the trailhead.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
      "mappings": [
        "https://w3id.org/semanticarts/ns/ontology/gist/comesFromPlace"
      ],
      "slot_uri": "https://w3id.org/semanticarts/ns/ontology/gist/comesFromPlace",
