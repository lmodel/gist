      "name": "Restriction",
      "definition_uri": "https://w3id.org/lmodel/gist/Restriction",
      "description": "A description of things one is prevented from doing.",
      "notes": [
        "OWL equivalentClass: (gist:Intention & \u2203prevents.gist:Behavior)"
      ],
      "examples": [
        {
          "value": "In the US, tax laws restrict the amount of money a person can put in retirement accounts over the course of a year.",
          "@type": "Example"
        }
      ],
      "in_subset": [
        "gist_core"
      ],
      "from_schema": "https://w3id.org/lmodel/gist/core",
